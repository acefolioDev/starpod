{
  "name": "starpod",
  "version": "0.1.0",
  "private": false,
  "description": "Atlas-owned routes and pods for Elysia on Bun. TypeScript only. No decorators.",
  "type": "module",
  "author": "Muhammad Atif <dev.muhammad.atif@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acefolioDev/starpod.git"
  },
  "homepage": "https://github.com/acefolioDev/starpod",
  "bugs": {
    "url": "https://github.com/acefolioDev/starpod/issues"
  },
  "keywords": ["bun", "elysia", "atlas", "pod", "typescript"],
  "exports": {
    ".": "./src/kernel/index.ts"
  },
  "bin": {
    "starpod": "src/cli/starpod.ts"
  },
  "files": ["src/kernel", "src/cli", "template", "README.md", "LICENSE"],
  "scripts": {
    "postinstall": "bun src/cli/postinstall.ts",
    "seal": "bun src/cli/starpod.ts seal"
  },
  "dependencies": {
    "elysia": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
